---
layout: base.njk
title: Newsletter
permalink: "/newsletter/"
---
<main>
  <div class="content-col" style="max-width:720px">
    <span class="kicker">Newsletter</span>
    <h1 class="headline">The Morning Dispatch</h1>
    <p class="dek">One email, every weekday morning. The Pacific stories that matter, before your coffee's cold.</p>

    <div style="background:var(--panel);border:1px solid var(--border);border-radius:10px;padding:28px;margin-top:24px">
      <label style="display:block;font-weight:700;margin-bottom:8px">Email address</label>
      <div style="display:flex;flex-wrap:wrap;gap:10px">
        <input type="email" placeholder="you@email.com" style="flex:1 1 260px;padding:12px 14px;border-radius:6px;border:1px solid var(--border);font-family:var(--sans);font-size:16px">
        <button style="padding:12px 22px;border-radius:6px;border:none;background:var(--maroon);color:#fff;font-family:var(--sans);font-size:16px;font-weight:700;cursor:pointer">Subscribe</button>
      </div>
      <p style="font-size:13px;color:var(--ink-faint);margin:12px 0 0">Free. No spam. Unsubscribe anytime.</p>
    </div>
  </div>
</main>