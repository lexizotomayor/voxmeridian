              <div class="mount__well" style="aspect-ratio:1/1"><img src="{{ s.photo }}" alt="{{ s.name }}"></div>
            </div>
            <div>
              <div class="staff__name">{{ s.name }}</div>
              <div class="staff__role">{{ s.role }}</div>
