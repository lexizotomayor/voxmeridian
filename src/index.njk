---
layout: home.njk
eleventyExcludeFromCollections: true
---
{# Structure follows the design file exactly: ONE two-column grid.
   row 1  main (lead + more stories)      |  rail (section nav, vertical wordmark)
   row 2  podcast band                    |  dark footer panel
   There is no horizontal masthead on the homepage — the wordmark IS the rail. #}
{% set lead = collections.articles[0] or collections.explainers[0] %}

<div class="homegrid" id="main">

  <main class="homegrid__main">
    {% if lead %}
    <article class="lead">
      <div class="lead__kicker">{% if lead.data.section %}Main Story / {{ lead.data.section }}{% else %}Explainer No. {{ lead.data.number }}{% endif %}</div>
      <h1 class="lead__title"><a href="{{ lead.url }}">{{ lead.data.title }}</a></h1>
      <div class="lead__byline">{{ lead.data.author }}{% if lead.data.authorRole %}, {{ lead.data.authorRole }}{% endif %}{% if lead.date %} · {{ lead.date | timeAgo }}{% endif %}</div>
      <div class="lead__split">
        <div class="mount mount--4x3">
          <div class="mount__well">
            {% if lead.data.image %}<img src="{{ lead.data.image }}" alt="{{ lead.data.imageAlt or '' }}">{% endif %}
          </div>
        </div>
        <div>
          <p class="lead__dek">{{ lead.data.dek }}</p>
          <a href="{{ lead.url }}" class="lead__more">Read full story<span aria-hidden="true">&rarr;</span></a>
        </div>
      </div>
    </article>
    {% endif %}

    {% if collections.articles.length > 1 %}
    <h2 class="rule-head">More stories</h2>
    <div class="storylist">
      {% for post in collections.articles %}
        {% if loop.index0 > 0 and loop.index0 < 6 %}
        <a href="{{ post.url }}" class="story story--photo">
          <div class="mount mount--sm story__thumb">
            <div class="mount__well">
              {% if post.data.image %}<img src="{{ post.data.image }}" alt="">{% endif %}
            </div>
          </div>
          <div style="min-width:0">
            <div class="kicker">{{ post.data.section }}</div>
            <div class="story__title">{{ post.data.title }}</div>
          </div>
          <div class="story__stamp">{{ post.data.author }}<br>{{ post.date | timeAgo }}</div>
        </a>
        {% endif %}
      {% endfor %}
    </div>
    {% endif %}

    <h2 class="rule-head" style="margin-top:34px">The Wire · {{ wire.all[0].day }}</h2>
    <p class="rule-head__note">What other newsrooms reported across the region. Each item names the outlet that did the work and links to the original — the summaries are ours, the reporting is theirs.</p>
    <div class="wire">
      {% for it in wire.all | limit(5) %}
      <article class="wire__item">
        <div class="wire__stamp">
          <div class="wire__time">{{ it.time }}</div>
          <div class="wire__place">{{ it.place }}</div>
        </div>
        <div>
          <h3 class="wire__title">{{ it.title }}</h3>
          <p class="wire__summary">{{ it.summary }}</p>
          <div class="wire__links">
            <a href="{{ it.url }}" target="_blank" rel="noopener" class="wire__via">Read it at {{ it.source }} &rarr;</a>
          </div>
        </div>
      </article>
      {% endfor %}
    </div>
    <div class="btn-row" style="margin-top:22px">
      <a href="/wire/" class="btn">The full wire</a>
      <a href="/subscribe/" class="btn btn--ghost">Get it by email</a>
    </div>
  </main>

  {# Right rail: section list, then the wordmark set vertically. This is the
     homepage's navigation — do not replace it with a horizontal bar. #}
  <aside class="rail-nav">
    <nav class="rail-nav__list" aria-label="Sections">
      {% for item in nav %}
      <a href="{{ item.url }}">{{ item.name }}</a>
      {% endfor %}
    </nav>
    <a href="/" class="nameplate" title="{{ site.name }} home">
      <div class="nameplate__word"><em>vox</em> meridian</div>
      <div class="nameplate__tag">{{ site.tagline }}</div>
    </a>
  </aside>

  {% if podcast.show and podcast.episodes.length %}
  <section class="homegrid__pod">
    <div class="rule-top"></div>
    <h2 class="rule-head">Podcast</h2>
    {% if podcast.sample %}<p class="rule-head__note">{{ podcast.caveat }}</p>{% endif %}
    <div class="podcast">
      {% for ep in podcast.episodes | limit(4) %}
      <a class="pod" href="{% if ep.audio %}{{ ep.audio }}{% else %}/podcast/{% endif %}">
        <span class="pod__play" aria-hidden="true">&#9654;</span>
        <span style="min-width:0">
          <span class="pod__title">{{ ep.title }}</span>
          <span class="pod__meta">Ep. {{ ep.ep }} · {{ ep.len }}</span>
        </span>
      </a>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  <section class="homegrid__foot">
    <div class="homefoot">
      <a href="/" class="homefoot__mark">vox meridian</a>
      <a href="/about/">About</a>
      <a href="/subscribe/">Subscribe</a>
      <a href="/rss/">RSS</a>
      <a href="/contact/">Contact</a>
      <div class="homefoot__legal">&copy; {{ build.date | yearOnly }} Vox Meridian Publications LLC</div>
      <div class="homefoot__design">Design &copy; {{ build.date | yearOnly }} Lexi Zotomayor</div>
    </div>
  </section>

</div>
