---
pagination:
  data: sections
  size: 1
  alias: section
permalink: "/{{ section | slugify }}/feed.xml"
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
<channel>
  <title>{{ site.name }} · {{ section }}</title>
  <link>{{ site.url }}/{{ section | slugify }}/</link>
  <atom:link href="{{ site.url }}/{{ section | slugify }}/feed.xml" rel="self" type="application/rss+xml"/>
  <description>{{ section }} reporting from {{ site.name }}.</description>
  <language>en</language>
  <lastBuildDate>{{ build.date | rfc822 }}</lastBuildDate>
  {% for post in collections.articles %}
  {% if post.data.section == section %}
  <item>
    <title>{{ post.data.title }}</title>
    <link>{{ site.url }}{{ post.url }}</link>
    <guid isPermaLink="true">{{ site.url }}{{ post.url }}</guid>
    <pubDate>{{ post.date | rfc822 }}</pubDate>
    <description>{{ post.data.dek }}</description>
  </item>
  {% endif %}
  {% endfor %}
</channel>
</rss>
