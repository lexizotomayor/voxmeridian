<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if title %}{{ title }} · {{ site.name }}{% else %}{{ site.name }} · {{ site.tagline }}{% endif %}</title>
<meta name="description" content="{{ dek or site.description }}">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
{% if not site.indexable %}<meta name="robots" content="noindex, nofollow">{% endif %}
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:title" content="{{ title or site.name }}">
<meta property="og:description" content="{{ dek or site.description }}">
<meta property="og:type" content="{% if layout == 'article.njk' %}article{% else %}website{% endif %}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
{% if image %}<meta property="og:image" content="{{ site.url }}{{ image }}">{% endif %}
<meta name="twitter:card" content="summary_large_image">
<link rel="alternate" type="application/rss+xml" title="{{ site.name }}" href="/feed.xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Google+Sans+Flex:wght@100;200;300;400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css">
</head>
<body>

<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
  <filter id="tornEdge">
    <feTurbulence type="fractalNoise" baseFrequency="0.026 0.012" numOctaves="4" seed="7" result="noise"/>
    <feDisplacementMap in="SourceGraphic" in2="noise" scale="11" xChannelSelector="R" yChannelSelector="G"/>
  </filter>
  <filter id="tornEdgeSmall">
    <feTurbulence type="fractalNoise" baseFrequency="0.05 0.03" numOctaves="3" seed="3" result="noise"/>
    <feDisplacementMap in="SourceGraphic" in2="noise" scale="6" xChannelSelector="R" yChannelSelector="G"/>
  </filter>
</svg>

<a href="#main" class="vh">Skip to the main story</a>

{% if site.preview %}
<div class="previewbar">
  <div class="shell previewbar__inner">
    <span class="previewbar__tag">For demo use</span>
    <span class="previewbar__text">{{ site.previewNote }}</span>
    <a href="/about/#preview" class="previewbar__link">What this means</a>
    <span class="previewbar__credit">Design &copy; {{ build.date | yearOnly }} Lexi Zotomayor</span>
  </div>
</div>
{% endif %}

<header class="masthead">
  <div class="shell masthead__bar">
    <a href="/" class="wordmark" title="{{ site.name }} home"><em>vox</em> meridian</a>
    <nav class="topnav" aria-label="Sections">
      {% for item in nav %}
      <a href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.name }}</a>
      {% endfor %}
    </nav>
  </div>
</header>

<div class="datebar">
  <div class="shell datebar__inner">
    <div class="datebar__date">{{ build.date | readableDate }} · {{ site.founded }}</div>
    <div class="ticker" aria-label="Market ticker">
      {# Two identical tracks: the marquee translates -50% so the loop is seamless.
         The second copy is aria-hidden so screen readers hear the row once. #}
      <div class="ticker__marquee">
        <div class="ticker__track">
          {% for t in ticker %}
          <span class="ticker__item">
            <span class="ticker__label">{{ t.label }}</span>
            <span class="ticker__val">{{ t.value }}</span>
            <span class="ticker__move--{{ t.dir }}">{{ t.move }}</span>
          </span>
          {% endfor %}
        </div>
        <div class="ticker__track" aria-hidden="true">
          {% for t in ticker %}
          <span class="ticker__item">
            <span class="ticker__label">{{ t.label }}</span>
            <span class="ticker__val">{{ t.value }}</span>
            <span class="ticker__move--{{ t.dir }}">{{ t.move }}</span>
          </span>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</div>

{% if sample %}
<div class="samplebar">
  <div class="shell samplebar__inner">
    <span class="samplebar__tag">Placeholder</span>
    <span class="samplebar__text">This page is a layout sample, not reporting. The design is real; the words are stand-ins while the newsroom fills the paper.</span>
  </div>
</div>
{% endif %}

{# Opinion / Explainers tab strip. Any page setting "tabs: true" in its front
   matter gets it, and the current URL takes the active tab. No JavaScript:
   these are two real pages, so the tabs survive a hard reload and deep links. #}
{% if tabs %}
<div class="tabs">
  <nav class="shell tabs__inner" aria-label="Opinion and explainers">
    <a href="/opinion/"{% if page.url == '/opinion/' or layout == 'column.njk' %} aria-current="page"{% endif %}>Opinion</a>
    <a href="/explainers/"{% if page.url == '/explainers/' or layout == 'explainer.njk' %} aria-current="page"{% endif %}>Explainers</a>
  </nav>
</div>
{% endif %}

<main id="main">
{{ content | safe }}
</main>

<footer class="sitefoot">
  <div class="shell sitefoot__inner">
    <div>
      <div class="wordmark"><em>vox</em> meridian</div>
      <div class="sitefoot__tag">{{ site.tagline }}</div>
    </div>
    <div class="sitefoot__col">
      <div class="sitefoot__links">
        <a href="/about/">About</a>
        <a href="/subscribe/">Subscribe</a>
        <a href="/wire/">The Wire</a>
        <a href="/rss/">RSS</a>
        <a href="/contact/">Contact</a>
      </div>
      <div class="sitefoot__legal">&copy; {{ build.date | yearOnly }} Vox Meridian Publications LLC. All rights reserved.</div>
      <div class="sitefoot__design">Design &copy; {{ build.date | yearOnly }} Lexi Zotomayor</div>
    </div>
  </div>
</footer>

</body>
</html>
