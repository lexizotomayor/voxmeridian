---
layout: base.njk
---
<article class="shell page">

  <div class="hero">
    <div>
      <div class="kicker">Explainer No. {{ number }}</div>
      <h1 class="hero__title">{{ title }}</h1>
      <p class="hero__dek">{{ dek }}</p>
      <div class="byline-strip" style="margin-top:26px">
        <span class="byline-strip__accent">{{ author }}</span>
        <span class="byline-strip__sep"></span>
        <span>Updated {{ page.date | readableDate }}</span>
        <span class="byline-strip__sep"></span>
        <span>{{ content | readtime }}</span>
      </div>
    </div>
    <div class="rail" aria-hidden="true">
      <div class="rail__stack">
        <div class="rail__label">Reference</div>
        <div class="rail__line"></div>
        <div class="rail__sub">Built from the document</div>
      </div>
      <div class="rail__word">{{ displayWord or 'how' }}</div>
    </div>
  </div>

  <div class="cols">
    <div class="cols__main">

      {% if question %}
      <div class="answer">
        <div class="kicker kicker--light">The short answer</div>
        <p class="answer__lede">{{ answer }}</p>
        {% if facts %}
        <div class="facts">
          {% for f in facts %}
          <div>
            <div class="facts__val">{{ f.value }}</div>
            <div class="facts__label">{{ f.label }}</div>
          </div>
          {% endfor %}
        </div>
        {% endif %}
      </div>
      {% endif %}

      {% if image %}
      <figure style="margin:0 0 clamp(30px,3.2vw,46px)">
        <div class="mount mount--3x2">
          <div class="mount__well"><img src="{{ image }}" alt="{{ imageAlt or '' }}"></div>
        </div>
        {% if caption %}<figcaption>{{ caption }}</figcaption>{% endif %}
      </figure>
      {% endif %}

      <div class="prose">
        {{ content | safe }}
      </div>

      {% if glossary %}
      <section style="margin-top:clamp(34px,3.6vw,50px)">
        <h2 class="rule-head">In plain words</h2>
        <div class="glossary">
          {% for g in glossary %}
          <div class="glossary__row">
            <div class="glossary__term">{{ g.term }}</div>
            <div class="glossary__plain">{{ g.plain }}</div>
          </div>
          {% endfor %}
        </div>
      </section>
      {% endif %}

      {% if sources %}
      <section style="margin-top:clamp(30px,3.2vw,44px)">
        <h2 class="rule-head">Sources</h2>
        <div class="glossary">
          {% for s in sources %}
          <div class="glossary__row">
            <div class="glossary__term">{{ s.kind }}</div>
            <div class="glossary__plain">{% if s.url %}<a href="{{ s.url }}" rel="noopener" style="color:var(--terra-dark);border-bottom:1px solid var(--terra-dark)">{{ s.name }}</a>{% else %}{{ s.name }}{% endif %}</div>
          </div>
          {% endfor %}
        </div>
      </section>
      {% endif %}

      <section class="panel panel--split" style="margin-top:clamp(36px,3.8vw,54px)">
        <div class="panel__rail">Ask us</div>
        <div>
          <h2 class="panel__title">Something here still unclear?</h2>
          <p class="panel__text">Explainers get rewritten when readers tell us a passage does not land. Ask, and we will either answer you or fix the page.</p>
          <form name="questions" method="POST" action="/thanks/?form=question" data-netlify="true" netlify-honeypot="bot-field">
            <p class="vh"><label>Do not fill this in <input name="bot-field"></label></p>
            <input type="hidden" name="about-explainer" value="No. {{ number }} — {{ title }}">
            <div class="field-row">
              <label class="field"><span class="field__label">Your name</span><input type="text" name="name" required></label>
              <label class="field"><span class="field__label">Email</span><input type="email" name="email" required></label>
            </div>
            <label class="field"><span class="field__label">Your question</span><textarea name="question" rows="3" required></textarea></label>
            <button type="submit" class="btn btn--light">Send the question</button>
          </form>
        </div>
      </section>

    </div>

    <aside class="cols__aside">
      <div>
        <h2 class="rule-head">All explainers</h2>
        <div class="sidelist">
          {% for ex in collections.explainers %}
          <a href="{{ ex.url }}"{% if ex.url == page.url %} aria-current="page"{% endif %}>
            <div class="kicker" style="margin-bottom:6px">No. {{ ex.data.number }}</div>
            <div class="sidelist__title">{{ ex.data.title }}</div>
          </a>
          {% endfor %}
        </div>
      </div>

      <div class="panel">
        <div class="kicker kicker--light" style="margin-bottom:12px">How this was built</div>
        <p style="font-size:15px;line-height:1.6;color:var(--ink-dark-bg);margin-bottom:14px">From the primary document itself — the agreement, the record, or the filing. Sources are listed above, and you can check every one.</p>
        <a href="/about/" class="btn btn--light">Our sourcing</a>
      </div>
    </aside>
  </div>

</article>
